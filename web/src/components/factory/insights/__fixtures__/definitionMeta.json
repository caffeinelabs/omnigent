    },
    {
      "paths": "previews.*, caps.*",
      "class": "B"
    },
    {
      "paths": "rules",
      "class": "B (owners), as a trial"
    },
    {
      "paths": "engine.*, autonomy.*",
      "class": "B (owners)"
    },
    {
      "paths": "budgets.*",
      "class": "A when lower (editors apply it at once), else B (owners)"
    },
    {
      "paths": "product.*, strategy.*",
      "class": "B (owners); never on trial, applies as a version"
    },
    {
      "paths": "discovery.enabled",
      "class": "A when turning it off, else B (owners)"
    },
    {
      "paths": "discovery.sources.<id>",
      "class": "A when it only narrows (pause, less budget, fewer roles), else B"
    },
    {
      "paths": "discovery.budgets.*",
      "class": "A when lower (editors apply it at once), else B (owners)"
    },
    {
      "paths": "discovery.cadence.*",
      "class": "A when slower or off, else B (owners)"
    },
    {
      "paths": "discovery.seat|rubric|thresholds|autonomy",
      "class": "B (owners)"
    },
    {
      "paths": "discovery.*, briefs.scout",
      "class": "never on trial until discovery guards exist"
    },
    {
      "paths": "briefs.*, role_defaults.*",
      "class": "B (owners)"
    },
    {
      "paths": "team.templates.*",
      "class": "B (owners); never on trial (it reaches a project on a switch)"
    },
    {
      "paths": "team.projects.<slug> members",
      "class": "adding a member, a vendor or model change, a brief: B (owners); removing one or a new handle: A (editors apply it)"
    },
    {
      "paths": "team.projects.<slug>.builders_at_once|budget_usd",
      "class": "A when lower, else B (owners); never on trial (too few PRs per team)"
    },
    {
      "paths": "owner-only paths, proposed by an agent",
      "class": "B (owners), whatever their class"
    },
    {
      "paths": "anything else, Tier 0",
      "class": "refused: 422 tier0"
    }
