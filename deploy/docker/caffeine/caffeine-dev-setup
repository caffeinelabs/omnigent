#!/usr/bin/env bash
# Idempotent setup for running a caffeinelabs repo's dev stack in a sandbox:
# npm + ghcr auth from the mounted bundle, and drops the bundle as the repo's
# .env. Run from the repo root. Keys come from a FILE, never the process env.
set -euo pipefail
SECRET_FILE="${CAFFEINE_APP_ENV_FILE:-/var/run/caffeine-app-env/app.env}"
if [ ! -f "$SECRET_FILE" ]; then
  echo "caffeine-dev-setup: no app-env file at $SECRET_FILE — bundle not mounted; nothing to do." >&2
  exit 0
fi
npm_tok="$(sed -n 's/^NPM_AUTH_TOKEN=//p' "$SECRET_FILE" | head -1)"
if [ -n "$npm_tok" ] && ! grep -qs 'npm.pkg.github.com/:_authToken' "${HOME}/.npmrc" 2>/dev/null; then
  printf '//npm.pkg.github.com/:_authToken=%s\n' "$npm_tok" >> "${HOME}/.npmrc"
  echo "caffeine-dev-setup: wrote ~/.npmrc auth for npm.pkg.github.com"
fi
# ghcr: use the PAT (npm_tok), NOT GH_TOKEN — the gh App token is denied on pulls.
if command -v docker >/dev/null 2>&1 && [ -n "$npm_tok" ]; then
  if printf '%s' "$npm_tok" | docker login ghcr.io -u token --password-stdin >/dev/null 2>&1; then
    echo "caffeine-dev-setup: docker logged in to ghcr.io"
  else
    echo "caffeine-dev-setup: WARN ghcr.io login failed" >&2
  fi
fi
if { [ -f package.json ] || [ -f mise.toml ]; } && [ ! -e ./.env ]; then
  install -m 0600 "$SECRET_FILE" ./.env && echo "caffeine-dev-setup: wrote ./.env from the app secret bundle"
fi
echo "caffeine-dev-setup: done. Next: pnpm install && pnpm dev"
