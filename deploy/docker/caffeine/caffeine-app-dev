#!/usr/bin/env bash
# ONE command to clone + boot a caffeinelabs repo's dev stack in a sandbox.
#
#   caffeine-app-dev [owner/repo] [git-ref]
#
# Defaults to caffeinelabs/app on the default branch. Re-runnable (skips clone
# if already present). Handles auth, the mise toolchain, deps, and starts the
# dev servers — non-interactively, so no prompts to babysit.
set -euo pipefail
repo="${1:-caffeinelabs/app}"; ref="${2:-}"; dir="${repo##*/}"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI="${CI:-1}"
mkdir -p "$HOME/workspace"; cd "$HOME/workspace"
if [ ! -d "$dir/.git" ]; then
  echo "==> cloning $repo"
  if [ -n "$ref" ]; then gh repo clone "$repo" "$dir" -- --branch "$ref"; else gh repo clone "$repo" "$dir"; fi
fi
cd "$dir"
echo "==> auth + .env (caffeine-dev-setup)"; caffeine-dev-setup
echo "==> toolchain (mise)"; mise trust >/dev/null 2>&1 || true; mise install
eval "$(mise env bash)"; corepack enable >/dev/null 2>&1 || true
echo "==> pnpm install"; pnpm install </dev/null
echo "==> pnpm dev"; exec pnpm dev </dev/null
